# Python bytecode and runtime caches
__pycache__/
*.py[cod]
*$py.class
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
skinclassifier/

# Environment variables and local credentials
.env
.env.*
!.env.example
.dvc/config.local

# Build and packaging output
build/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/

# Test, coverage, and type-checker output
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Logs and local application state
*.log
instance/
.webassets-cache/

# Jupyter and interactive Python
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Editor and operating-system files
.vscode/
.idea/
.vs/
.DS_Store
Thumbs.db
Desktop.ini

# DVC cache/temp data; keep dvc.yaml, dvc.lock, .dvc/config, and *.dvc files
.dvc/cache/
.dvc/tmp/

# Local datasets. Keep DVC pointer files beside the ignored data directories.
/artifacts/data_source/**
!/artifacts/data_source/*.dvc

# Generated model, callback, and training outputs
/artifacts/prepare_base_model/
/artifacts/prepare_callbacks/
/artifacts/training/*.h5
/artifacts/training/vgg16model.zip
/artifacts/training/vgg16model..zip
/artifacts/training/*.keras
/artifacts/training/*.weights.h5
# Legacy metadata file from runs before timestamped metadata directories.
/artifacts/training/run_metadata.json
/artifacts/training/run_metadata.json.tmp
/artifacts/training/run_metadata/
/artifacts/training/checkpoints/
/artifacts/training/tensorboard/

# TensorFlow / accelerator caches
*.tfevents
*.tfevents.*
*.prof
